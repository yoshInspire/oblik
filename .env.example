# Скопировать в .env и заполнить. Сам .env в репозиторий не попадает.

# Домен сайта. Влияет на canonical, sitemap.xml и микроразметку.
# Без него всё это будет ссылаться на versta.studio.
NEXT_PUBLIC_SITE_URL=https://example.ru

# Уведомления о заявках в Telegram. Если не заданы — заявка всё равно
# сохранится в data/leads.jsonl, просто не придёт оповещение.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательный вебхук: заявка уходит POST-запросом в формате JSON.
LEAD_WEBHOOK_URL=

# Уведомления о заявках на почту. Пока не заполнены SMTP_HOST, SMTP_USER
# и SMTP_PASSWORD — письма не отправляются, заявка просто ложится в файл.
# Для Яндекс-почты: хост smtp.yandex.ru, порт 465, в SMTP_PASSWORD —
# пароль приложения из Яндекс ID, а не обычный пароль от ящика.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Куда слать письмо. Если пусто — на адрес из SMTP_USER.
LEAD_EMAIL_TO=
