# Скопируйте в .env.local и заполните. .env.local в репозиторий не попадает.

# Боевой адрес сайта. Используется в canonical, Open Graph, sitemap.xml и robots.txt.
# Без него всё это будет ссылаться на versta.studio.
NEXT_PUBLIC_SITE_URL=https://versta.studio

# Уведомления о заявках в Telegram.
# Токен выдаёт @BotFather, chat_id можно узнать у @userinfobot.
# Если переменные не заданы, заявка всё равно сохраняется в data/leads.jsonl.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Приём заявок внешней системой: CRM, интеграционный сервис, почтовый шлюз.
# На адрес уходит POST с JSON-телом заявки.
LEAD_WEBHOOK_URL=
